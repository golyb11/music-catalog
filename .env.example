# Строка подключения к PostgreSQL.
# Для локального запуска без Docker (БД поднята отдельно, например контейнером из docker-compose):
DATABASE_URL="postgresql://music:music@localhost:5432/music?schema=public"
# Для запуска внутри docker compose значение подставляется автоматически в docker-compose.yml.

# Сидирование демо-данными при старте контейнера app (true/false).
SEED_DEMO_DATA=true
